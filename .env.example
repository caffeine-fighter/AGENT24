# Copy to .env after the coding window opens. Never commit the real file.
OPENAI_API_KEY=

# Leave blank to use the SDK default until the team deliberately selects a model.
OPENAI_MODEL=

# Optional: required only when the submitted GitHub Agent repository is private.
# The value is used for metadata/manifest reads and is never emitted to events.
GITHUB_TOKEN=

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
RAW_EVENT_LOG_DIR=artifacts/raw-streams
