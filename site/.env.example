# Optional OpenAI planning path. Leave empty to use the explicit offline demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GITHUB_TOKEN=

# Required in hosted production so encrypted run contexts survive Edge isolates.
# Generate a random value of at least 32 bytes and store it as a hosting secret.
RUN_CONTEXT_SECRET=

# Optional lifetime for an accepted run context. Default: 300000 (5 minutes).
RUN_CONTEXT_TTL_MS=300000
